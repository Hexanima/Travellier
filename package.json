{
  "name": "travellier",
  "description": "Aplicación mobile para organizar viajes grupales.",
  "private": true,
  "workspaces": [
    "domain",
    "apps/*"
  ],
  "type": "module",
  "packageManager": "yarn@4.9.1",
  "devDependencies": {
    "serverless": "4.42.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "lint": "yarn workspaces foreach -A --parallel run lint",
    "typecheck": "yarn workspaces foreach -A --parallel run typecheck",
    "test": "node --test scripts/quality-contract.test.mjs scripts/infrastructure-contract.test.mjs && yarn workspaces foreach -A --parallel run test --run --clearScreen false",
    "build": "yarn workspaces foreach -A --topological run build",
    "infrastructure:print:dev": "serverless print --stage dev",
    "infrastructure:print:prod": "serverless print --stage prod",
    "infrastructure:package:dev": "serverless package --stage dev",
    "infrastructure:package:prod": "serverless package --stage prod",
    "infrastructure:deploy:dev": "serverless deploy --stage dev",
    "infrastructure:deploy:prod": "serverless deploy --stage prod"
  }
}
