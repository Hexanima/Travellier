      "css": ".ds-tabs{display:flex;gap:8px;padding:12px 24px}.ds-tabs button{flex:0 1 92px;min-width:0;min-height:44px;background:var(--paper,#faf8f4);color:var(--muted,#5e6c79);font:600 14px/20px Manrope,system-ui,sans-serif;border:0;border-radius:12px;padding:12px}.ds-tabs button:first-child{flex:0 1 108px}.ds-tabs button[aria-pressed=true]{background:var(--brand,#16324f);color:var(--on-brand,#fff)}.ds-tabs button:hover{cursor:pointer}.ds-tabs button:focus-visible{outline:3px solid var(--focus,#264b70);outline-offset:3px}@media(prefers-reduced-motion:no-preference){.ds-tabs button{transition:background-color 150ms ease,color 150ms ease}.ds-tabs button:active{transform:translateY(1px)}}"
