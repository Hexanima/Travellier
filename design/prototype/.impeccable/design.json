      "html": "<section class=\"ds-transport\"><span>09:45 · Llegada</span><h4>Llegamos a Roma</h4><p>Fiumicino · Vuelo AZ 681</p></section>",
      "css": ".ds-transport{display:flex;flex-direction:column;gap:8px;padding:16px;background:var(--soft,#eaf0f6);border-radius:16px;font-family:Manrope,system-ui,sans-serif;color:var(--ink,#1c2c3c)}.ds-transport span{font-size:12px;line-height:18px;font-weight:600;color:var(--brand,#16324f)}.ds-transport h4{margin:0;font-size:18px;line-height:26px;font-weight:700}.ds-transport p{margin:0;font-size:14px;line-height:20px;color:var(--muted,#5e6c79)}"
