      "description": "Campos normal, enfocado, error y deshabilitado; 56px.",
      "html": "<div class=\"ds-fields\"><label class=\"ds-field\">Nombre<input placeholder=\"Cena en Trastevere\"></label><label class=\"ds-field\">Código · enfocado<input class=\"ds-source-focused\" value=\"ITALIA26\" readonly></label><label class=\"ds-field\">Código · error<input aria-invalid=\"true\" aria-describedby=\"ds-field-error\" placeholder=\"Ingresá el código\" readonly></label><p class=\"ds-field-error\" id=\"ds-field-error\">Código de ejemplo no válido.</p><label class=\"ds-field\">Código · deshabilitado<input placeholder=\"Ingresá el código\" disabled></label></div>",
      "css": ".ds-fields{display:grid;gap:16px}.ds-field{display:flex;flex-direction:column;gap:8px;font:600 14px/20px Manrope,system-ui,sans-serif;color:var(--ink,#1c2c3c)}.ds-field input{font:400 16px/24px Manrope,system-ui,sans-serif;width:100%;min-width:0;height:56px;border:1px solid var(--line,#d9dfe4);background:var(--surface,#fff);color:var(--ink,#1c2c3c);border-radius:12px;padding:15px 16px;caret-color:var(--brand,#16324f)}.ds-field input::placeholder{color:var(--muted,#5e6c79)}.ds-field .ds-source-focused{border:2px solid var(--focus,#264b70);padding:14px 15px}.ds-field input:hover{cursor:text}.ds-field input:focus-visible{outline:2px solid var(--focus,#264b70);outline-offset:3px}.ds-field input[aria-invalid=true],.ds-field input[aria-invalid=true]::placeholder{color:#bc3030}.ds-field input[aria-invalid=true]{border-color:#bc3030}.ds-field input:disabled{background:#f0ebe3;color:var(--muted,#5e6c79)}.ds-field-error{margin:0;font:400 14px/20px Manrope,system-ui,sans-serif;color:#bc3030}"
