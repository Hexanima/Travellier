    {
      "name": "Trip card · source geometry",
      "kind": "card",
      "refersTo": "trip-card",
      "description": "Ruta y divisor originales, fechas e iniciales; relleno azul plano.",
      "html": "<button class=\"ds-trip\"><span class=\"ds-trip-top\"><span>Sale en 7 días</span><span>Privado</span></span><strong class=\"ds-trip-title\">Italia, sin apuro</strong><span class=\"ds-route\"><span>BUE</span><svg class=\"ds-stitch\" viewBox=\"0 0 136 1.5\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><line y1=\".75\" x2=\"136\" y2=\".75\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-dasharray=\"4 5\"/></svg><svg class=\"ds-trip-plane\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M18.3333 1.66667L7.5 12.5M18.3333 1.66667L12.5 18.3333L9.16667 10.8333L1.66667 7.5L18.3333 1.66667Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>ROM</span></span><span class=\"ds-trip-destinations\">Roma → Florencia → Venecia</span><svg class=\"ds-divider\" viewBox=\"0 0 294 1.5\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><line y1=\".75\" x2=\"294\" y2=\".75\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-dasharray=\"4 5\"/></svg><span class=\"ds-trip-bottom\"><span>12–22 oct 2026</span><small>NC · AL · +2</small></span></button>",
      "css": ".ds-trip{width:100%;height:260px;border:0;border-radius:16px;background:var(--brand,#16324f);color:var(--on-brand,#fff);padding:24px;display:flex;flex-direction:column;gap:12px;align-items:stretch;text-align:left;font-family:Manrope,system-ui,sans-serif;cursor:pointer}.ds-trip-top{display:flex;justify-content:space-between;font:600 12px/18px Manrope,system-ui,sans-serif;color:var(--on-brand-muted,#c5d5e5)}.ds-trip-title,.ds-route{font:700 24px/32px Manrope,system-ui,sans-serif}.ds-route{display:flex;align-items:center;gap:12px}.ds-stitch{flex:1;min-width:0;height:1.5px;color:var(--on-brand-muted,#c5d5e5)}.ds-trip-plane{width:20px;height:20px;flex-shrink:0}.ds-divider{height:1.5px;width:100%;color:var(--on-brand-muted,#c5d5e5)}.ds-trip-destinations{font:400 14px/20px Manrope,system-ui,sans-serif;color:var(--on-brand-muted,#c5d5e5)}.ds-trip-bottom{display:flex;justify-content:space-between;align-items:center;font:600 14px/20px Manrope,system-ui,sans-serif}.ds-trip-bottom small{font-size:12px;line-height:18px}.ds-trip:hover{cursor:pointer}.ds-trip:focus-visible{outline:3px solid var(--focus,#264b70);outline-offset:3px}@media(prefers-reduced-motion:no-preference){.ds-trip{transition:background-color 150ms ease,color 150ms ease}.ds-trip:active{transform:translateY(1px)}}"
    }
