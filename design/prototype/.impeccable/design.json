      "html": "<div class=\"ds-secondary-stack\"><button class=\"ds-secondary\">Crear viaje</button><button class=\"ds-secondary ds-secondary-pressed\">Crear viaje</button><button class=\"ds-secondary\" disabled>Crear viaje</button><button class=\"ds-secondary ds-secondary-loading\" disabled aria-busy=\"true\">Cargando…</button><small>Estados de muestra; no hay una carga en curso.</small></div>",
      "css": ".ds-secondary-stack{display:grid;gap:12px}.ds-secondary-stack small{font:400 14px/20px Manrope,system-ui,sans-serif;color:var(--muted,#5e6c79)}.ds-secondary{font:600 14px/20px Manrope,system-ui,sans-serif;width:100%;min-height:52px;padding:15px;border:1px solid var(--line,#d9dfe4);border-radius:12px;background:var(--surface,#fff);color:var(--brand,#16324f);cursor:pointer}.ds-secondary:disabled{background:#f0ebe3;color:var(--muted,#5e6c79);cursor:not-allowed}.ds-secondary.ds-secondary-loading:disabled{background:var(--surface,#fff);color:var(--brand,#16324f)}.ds-secondary:not(:disabled):hover,.ds-secondary.ds-secondary-pressed{background:var(--surface,#fff);border-color:var(--line,#d9dfe4)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#264b70);outline-offset:3px}@media(prefers-reduced-motion:no-preference){.ds-secondary{transition:background-color 150ms ease,color 150ms ease}.ds-secondary:active{transform:translateY(1px)}}"
